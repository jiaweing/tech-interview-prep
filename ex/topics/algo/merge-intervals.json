 "when": [
  "Overlapping ranges, meetings or bookings",
  "Insert a new range into a sorted list of ranges",
  "How many rooms do these meetings need?",
  "Total time covered by a set of ranges"
 ],
 "python": "def merge(intervals):\n    out = []\n    for start, end in sorted(intervals):  # sort by start\n        if out and start <= out[-1][1]:    # overlaps the open block\n            out[-1][1] = max(out[-1][1], end)\n        else:\n            out.append([start, end])       # gap: open a new block\n    return out\nprint(merge([[6, 7], [0, 2], [7, 9], [1, 4]]))\nprint(merge([[1, 10], [2, 3]]))",
 "output": "[[0, 4], [6, 9]]\n[[1, 10]]",
 "cost": [
