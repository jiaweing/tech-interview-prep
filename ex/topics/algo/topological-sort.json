 "python": "from collections import deque\nbefore = {\"C\": [\"A\"], \"D\": [\"A\", \"E\"], \"A\": [\"B\"], \"B\": [\"E\"], \"E\": []}\nindeg = {n: 0 for n in before}\nfor n in before:\n    for m in before[n]:\n        indeg[m] += 1\nready = deque(n for n in before if indeg[n] == 0)\norder = []\nwhile ready:\n    n = ready.popleft()\n    order.append(n)\n    for m in before[n]:\n        indeg[m] -= 1\n        if indeg[m] == 0:\n            ready.append(m)\nprint(order if len(order) == len(before) else \"cycle!\")",
 "output": "['C', 'D', 'A', 'B', 'E']",
