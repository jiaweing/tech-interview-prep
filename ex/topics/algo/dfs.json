 "python": "graph = {\"A\": [\"B\", \"C\"], \"B\": [\"A\", \"D\", \"E\"], \"C\": [\"A\", \"F\"],\n         \"D\": [\"B\"], \"E\": [\"B\", \"F\"], \"F\": [\"C\", \"E\"]}\n\ndef dfs(node, seen, order):\n    seen.add(node)\n    order.append(node)\n    for nxt in graph[node]:\n        if nxt not in seen:\n            dfs(nxt, seen, order)\n    return order\n\nprint(dfs(\"A\", set(), []))",
 "output": "['A', 'B', 'D', 'E', 'F', 'C']",
