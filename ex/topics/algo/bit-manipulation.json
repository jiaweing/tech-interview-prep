 "python": "x = 12\nprint(bin(x))             # 0b1100 = 8 + 4\nprint(x & 1)              # last bit: 0 means even\nprint(x >> 1, x << 1)     # halve, double\nprint(x & (x - 1))        # clear the lowest 1 bit\nprint(bin(x).count(\"1\"))  # how many 1 bits\ndef single(nums):\n    acc = 0\n    for n in nums:\n        acc ^= n          # pairs cancel: a ^ a == 0\n    return acc\nprint(single([4, 1, 2, 1, 2]))",
