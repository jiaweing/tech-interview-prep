 "python": "from collections import deque\ngraph = {\"A\": [\"B\", \"C\"], \"B\": [\"A\", \"D\", \"E\"], \"C\": [\"A\", \"F\"],\n         \"D\": [\"B\"], \"E\": [\"B\", \"F\"], \"F\": [\"C\", \"E\"]}\n\ndef bfs(start):\n    steps = {start: 0}\n    queue = deque([start])\n    while queue:\n        node = queue.popleft()\n        for nxt in graph[node]:\n            if nxt not in steps:\n                steps[nxt] = steps[node] + 1\n                queue.append(nxt)\n    return steps\n\nprint(bfs(\"A\"))",
 "output": "{'A': 0, 'B': 1, 'C': 1, 'D': 2, 'E': 2, 'F': 2}",
