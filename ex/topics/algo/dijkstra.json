 "when": [
  "Shortest path where edges have weights or costs",
  "Cheapest flight, fastest route, lowest delay",
  "Every weight is zero or positive",
  "Plain BFS would count hops, but hops aren't equal"
 ],
 "python": "import heapq\nroads = {\"A\": {\"B\": 4, \"C\": 1}, \"B\": {\"A\": 4, \"C\": 2, \"D\": 1}, \"C\": {\"A\": 1, \"B\": 2, \"D\": 5},\n         \"D\": {\"B\": 1, \"C\": 5, \"E\": 3}, \"E\": {\"D\": 3}}\ndef dijkstra(start):\n    dist = {start: 0}\n    heap = [(0, start)]  # (cost so far, node), cheapest pops first\n    while heap:\n        d, node = heapq.heappop(heap)\n        if d > dist[node]:\n            continue  # an old entry, we already found cheaper\n        for nxt, w in roads[node].items():\n            if d + w < dist.get(nxt, float(\"inf\")):\n                dist[nxt] = d + w\n                heapq.heappush(heap, (d + w, nxt))\n    return dist\nprint(dijkstra(\"A\"))",
 "output": "{'A': 0, 'B': 3, 'C': 1, 'D': 4, 'E': 7}",
