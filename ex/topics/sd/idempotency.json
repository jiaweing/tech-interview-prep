 ],
 "python": "seen = {}          # idempotency key -> the answer we sent\ncharges = []\n\ndef pay(key, amount):\n    if key in seen:\n        return seen[key]               # repeat: same answer, no new charge\n    charges.append(amount)\n    seen[key] = \"receipt \" + str(9920 + len(charges))\n    return seen[key]\n\nkey = \"k-81f3\"     # made once per order, e.g. str(uuid.uuid4())\nprint(pay(key, 50))\nprint(pay(key, 50))  # the app retries after a timeout\nprint(\"charges:\", charges)",
 "output": "receipt 9921\nreceipt 9921\ncharges: [50]",
