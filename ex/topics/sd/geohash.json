 "python": "B32 = \"0123456789bcdefghjkmnpqrstuvwxyz\"\n\ndef geohash(lat, lon, length=6):\n    ranges, bits = {\"lon\": [-180, 180], \"lat\": [-90, 90]}, \"\"\n    while len(bits) < length * 5:\n        axis = \"lon\" if len(bits) % 2 == 0 else \"lat\"      # take turns\n        lo, hi = ranges[axis]\n        mid, val = (lo + hi) / 2, (lon if axis == \"lon\" else lat)\n        bits += \"1\" if val >= mid else \"0\"\n        ranges[axis] = [mid, hi] if val >= mid else [lo, mid]\n    return \"\".join(B32[int(bits[i:i + 5], 2)] for i in range(0, len(bits), 5))\n\nfor name, lat, lon in [(\"you\", 37.7955, -122.3937), (\"cafe\", 37.7946, -122.3990),\n                       (\"oakland\", 37.8044, -122.2712)]:\n    print(f\"{name:8}\", geohash(lat, lon))",
