  "Work must not be lost if a server crashes",
  "The sender and the worker should scale separately"
 ],
 "python": "from collections import deque\n\nqueue = deque(f\"video{i}\" for i in range(1, 6))   # 5 uploads arrive at once\ndone, crashed_once = [], False\nwhile queue:\n    job = queue.popleft()                        # a worker takes the next job\n    if job == \"video2\" and not crashed_once:\n        crashed_once = True\n        print(\"worker crashed on\", job, \"-> back in the queue\")\n        queue.append(job)                        # never acked, so it is handed out again\n        continue\n    done.append(job)                             # ack: finished, remove it for good\nprint(\"done:\", done)",
 "output": "worker crashed on video2 -> back in the queue\ndone: ['video1', 'video3', 'video4', 'video5', 'video2']",
