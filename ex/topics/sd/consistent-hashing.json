 "when": [
  "Keys are spread over cache or database servers that come and go",
  "hash % N would reshuffle everything when N changes",
  "Someone says distributed cache or Dynamo",
  "Sharding needs to grow without a big migration"
 ],
 "python": "import bisect, hashlib\n\ndef h(key):                                   # a stable hash -> a spot on a 0-359 ring\n    return int(hashlib.md5(key.encode()).hexdigest(), 16) % 360\n\ndef owner(key, servers):\n    ring = sorted((h(s), s) for s in servers)\n    i = bisect.bisect(ring, (h(key), \"\"))     # first server clockwise from the key\n    return ring[i % len(ring)][1]             # past the end? wrap around to the start\n\nkeys = [\"kim\", \"bob\", \"dan\", \"ivy\"]\nprint(\"spots:\", {name: h(name) for name in keys + [\"A\", \"B\", \"C\", \"D\"]})\nprint(\"3 servers:\", {k: owner(k, [\"A\", \"B\", \"C\"]) for k in keys})\nprint(\"add D:    \", {k: owner(k, [\"A\", \"B\", \"C\", \"D\"]) for k in keys})",
 "output": "spots: {'kim': 98, 'bob': 152, 'dan': 222, 'ivy': 324, 'A': 265, 'B': 193, 'C': 295, 'D': 125}\n3 servers: {'kim': 'B', 'bob': 'B', 'dan': 'A', 'ivy': 'B'}\nadd D:     {'kim': 'D', 'bob': 'B', 'dan': 'A', 'ivy': 'D'}",
 "cost": [
