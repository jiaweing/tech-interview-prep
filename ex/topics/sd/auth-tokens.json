 "python": "import hmac, hashlib, json\nSECRET = b\"only-the-servers-know-this\"\nmac = lambda body: hmac.new(SECRET, body.encode(), hashlib.sha256).hexdigest()[:12]\ndef verify(token, now):\n    body, sig = token.rsplit(\".\", 1)\n    if not hmac.compare_digest(sig, mac(body)):\n        return \"401 bad signature\"\n    data = json.loads(body)\n    return \"401 expired\" if now > data[\"exp\"] else \"ok, user \" + str(data[\"user\"])\n\nbody = json.dumps({\"user\": 42, \"exp\": 900})        # issued at t=0, valid 15 minutes\ntoken = body + \".\" + mac(body)\nprint(token, \"->\", verify(token, now=60))\nprint(verify(token.replace('\"user\": 42', '\"user\": 43'), now=60))\nprint(verify(token, now=901))",
 "output": "{\"user\": 42, \"exp\": 900}.48f84b54150d -> ok, user 42\n401 bad signature\n401 expired",
