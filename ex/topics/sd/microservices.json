 "python": "events = []                                  # a queue Notify reads later\ndef payments(amount, up):                    # another service, over the network\n    if not up:\n        raise ConnectionError(\"payments is down\")\n    return \"charged $\" + str(amount)\ndef orders(item, amount, payments_up=True):\n    try:\n        receipt = payments(amount, payments_up)\n    except ConnectionError as err:\n        return \"checkout failed: \" + str(err)\n    events.append((\"order_placed\", item))\n    return item + \", \" + receipt\nprint(orders(\"ramen\", 24))\nprint(orders(\"pad thai\", 18, payments_up=False))\nprint(\"events for Notify:\", events)",
