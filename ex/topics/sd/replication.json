 "when": [
  "Many more reads than writes",
  "The database must survive a machine dying",
  "Users in other regions need fast reads",
  "Reads can be a moment out of date"
 ],
 "python": "primary, replicas = {}, [{}, {}]\npending = []                          # changes not yet copied to the replicas\n\ndef write(key, value):\n    primary[key] = value\n    pending.append((key, value))\ndef replicate():                      # runs in the background, a few ms later\n    for key, value in pending:\n        for replica in replicas:\n            replica[key] = value\n    pending.clear()\nwrite(\"ana.bio\", \"loves tea\")\nprint(\"replica before copy:\", replicas[1].get(\"ana.bio\"))\nreplicate()\nprint(\"replica after copy: \", replicas[1].get(\"ana.bio\"))",
 "output": "replica before copy: None\nreplica after copy:  loves tea",
