 "when": [
  "Users are spread across countries",
  "Lots of images, video or other static files",
  "The same file is downloaded by many people",
  "Page load time matters"
 ],
 "python": "edges = {\"Sydney\": (-34, 151), \"London\": (51, 0), \"Virginia\": (38, -77)}\ncache = {name: set() for name in edges}\n\ndef nearest(lat, lon):\n    return min(edges, key=lambda e: (edges[e][0] - lat) ** 2 + (edges[e][1] - lon) ** 2)\n\nfor user, lat, lon in [(\"ana\", -33, 151), (\"bob\", -37, 145), (\"eve\", 52, -1)]:\n    edge = nearest(lat, lon)\n    status = \"hit\" if \"cat.jpg\" in cache[edge] else \"miss, fetch from origin\"\n    cache[edge].add(\"cat.jpg\")\n    print(user, \"->\", edge, \"edge:\", status)",
 "output": "ana -> Sydney edge: miss, fetch from origin\nbob -> Sydney edge: hit\neve -> London edge: miss, fetch from origin",
