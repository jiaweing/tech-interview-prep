 "python": "subscribers = {}\n\ndef subscribe(topic, name):\n    subscribers.setdefault(topic, []).append(name)\n\ndef publish(topic, event):\n    for name in subscribers.get(topic, []):     # every subscriber gets a copy\n        print(f\"{name:<9} got {event}\")\n\nfor name in [\"email\", \"stock\", \"analytics\"]:\n    subscribe(\"orders\", name)\npublish(\"orders\", \"order 812 placed\")\nsubscribe(\"orders\", \"fraud\")                    # added later; checkout unchanged\npublish(\"orders\", \"order 813 placed\")",
 "output": "email     got order 812 placed\nstock     got order 812 placed\nanalytics got order 812 placed\nemail     got order 813 placed\nstock     got order 813 placed\nanalytics got order 813 placed\nfraud     got order 813 placed",
