 "python": "cache, CAPACITY = {}, 2\n\ndef get(key):\n    if key in cache:\n        cache[key] = cache.pop(key)          # move to the end: most recently used\n        return \"hit\"\n    if len(cache) >= CAPACITY:\n        oldest = next(iter(cache))           # first key = least recently used\n        del cache[oldest]\n        print(\"  evict\", oldest)\n    cache[key] = f\"page for {key}\"           # pretend this was a 50 ms database query\n    return \"miss\"\n\nfor key in [\"home\", \"sports\", \"home\", \"world\", \"sports\"]:\n    print(key, get(key))",
