 "python": "records = {\"shop.example.com\": (\"93.184.216.34\", 300)}   # the name server's answer and its TTL\ncache = {}\n\ndef resolve(name, now):\n    if name in cache and cache[name][1] > now:\n        return cache[name][0], \"from cache\"\n    ip, ttl = records[name]               # the slow trip: root, then .com, then name server\n    cache[name] = (ip, now + ttl)\n    return ip, \"asked the name servers\"\n\nfor now in [0, 10, 299, 301]:\n    print(f\"t={now}s\", *resolve(\"shop.example.com\", now))",
 "output": "t=0s 93.184.216.34 asked the name servers\nt=10s 93.184.216.34 from cache\nt=299s 93.184.216.34 from cache\nt=301s 93.184.216.34 asked the name servers",
