 "python": "users = range(1, 100_001)\nbefore = {u: u % 4 for u in users}             # 4 shards\nafter = {u: u % 5 for u in users}              # add a 5th shard\nprint(\"user 1001 -> shard\", before[1001])\ncounts = [0] * 4\nfor shard in before.values():\n    counts[shard] += 1\nprint(\"users per shard:\", counts)\nmoved = sum(before[u] != after[u] for u in users)\nprint(f\"after adding a shard, {moved / len(users):.0%} of users move\")",
