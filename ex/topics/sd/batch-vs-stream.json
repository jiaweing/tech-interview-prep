 "python": "from collections import Counter\nevents = [(\"cat\", 9), (\"dog\", 9), (\"cat\", 10), (\"cat\", 23), (\"dog\", 23)]  # (video, hour)\n\n# Batch: wait for the whole day, then count everything at once\nprint(\"batch at midnight:\", dict(Counter(video for video, hour in events)))\n\n# Stream: update a running count as each event arrives\nlive = Counter()\nfor video, hour in events:\n    live[video] += 1\n    print(f\"stream at {hour:>2}:00 ->\", dict(live))",
 "output": "batch at midnight: {'cat': 3, 'dog': 2}\nstream at  9:00 -> {'cat': 1}\nstream at  9:00 -> {'cat': 1, 'dog': 1}\nstream at 10:00 -> {'cat': 2, 'dog': 1}\nstream at 23:00 -> {'cat': 3, 'dog': 1}\nstream at 23:00 -> {'cat': 3, 'dog': 2}",
