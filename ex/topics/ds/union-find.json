 "python": "parent = list(range(6))\ndef find(x):\n    while parent[x] != x:\n        parent[x] = parent[parent[x]]   # shortcut: skip a level\n        x = parent[x]\n    return x\ndef union(a, b):\n    parent[find(b)] = find(a)\n\nunion(0, 1)\nunion(2, 3)\nunion(1, 3)\nprint(find(3), find(1))\nprint(find(0) == find(4))\nprint(len({find(x) for x in range(6)}))",
