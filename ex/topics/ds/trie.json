 "python": "trie = {}\nfor word in [\"car\", \"cat\", \"cup\"]:\n    node = trie\n    for ch in word:\n        node = node.setdefault(ch, {})\n    node[\"$\"] = True              # a word ends here\ndef walk(s):\n    node = trie\n    for ch in s:\n        node = node.get(ch)\n        if node is None:\n            return None\n    return node\nprint(\"$\" in walk(\"cat\"), \"$\" in walk(\"ca\"))\nprint(walk(\"cu\") is not None, walk(\"dog\"))",
 "output": "True False\nTrue None",
