  },
  {
   "name": "System design",
   "minutes": 60,
   "kind": "design",
   "what": "Discussion of architecture and scaling, with trade-offs on reliability and cost; no coding.",
   "practice": "sd-practice",
   "source": "https://www.atlassian.com/company/careers/resources/interviewing/engineering"
  },
  {
   "name": "Manager interview",
   "minutes": 60,
   "kind": "behavioural",
   "what": "Deep dive into one or two past projects: scope, impact, collaboration and lessons.",
   "practice": "dd-mock",
   "source": "https://interviewing.io/atlassian-interview-questions"
  },
  {
   "name": "Values interview",
   "minutes": 45,
   "kind": "behavioural",
   "what": "Scenario questions on Atlassian's five values, often with an interviewer from outside engineering.",
   "practice": "dd-mock",
   "source": "https://interviewing.io/atlassian-interview-questions"
  }
 ],
 "tips": [
  "Learn Atlassian's five values and tie your stories to them.",
  "In code design, start simple and keep the design open to new requirements.",
  "Talk through trade-offs before coding; missing a line is not a deal-breaker.",
  "Practise short system design answers for the Karat screen as well as coding.",
  "Prepare one or two past projects in depth for the manager round."
