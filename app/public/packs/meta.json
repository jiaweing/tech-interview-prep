  },
  {
   "name": "Technical screen",
   "minutes": 45,
   "kind": "coding",
   "what": "Usually two easy-to-medium problems in CoderPad with code execution off.",
   "practice": "leetcode",
   "source": "https://interviewing.io/guides/hiring-process/meta-facebook"
  },
  {
   "name": "Onsite coding",
   "minutes": 45,
   "kind": "coding",
   "what": "Two problems per round; a working optimal solution is expected.",
   "practice": "leetcode",
   "source": "https://www.hellointerview.com/guides/meta/e4"
  },
  {
   "name": "AI-enabled coding",
   "minutes": 60,
   "kind": "coding",
   "what": "One multi-part problem in a multi-file codebase with an AI assistant; replaces one coding round.",
   "practice": "problems",
   "source": "https://interviewing.io/guides/hiring-process/meta-facebook"
  },
  {
   "name": "System design or product architecture",
   "minutes": 45,
   "kind": "design",
   "what": "Large-scale design or API and data model design; it drives the level decision.",
   "practice": "sd-practice",
   "source": "https://www.hellointerview.com/guides/meta/e4"
  },
  {
   "name": "Behavioural",
   "minutes": 45,
   "kind": "behavioural",
   "what": "Conflict, mistakes, disagreements and project impact.",
   "practice": "dd-mock",
   "source": "https://www.hellointerview.com/guides/meta/e4"
  }
 ],
 "tips": [
  "Practise finishing two medium problems in about 35 minutes without running code.",
  "Expect variants of known Meta-tagged problems with an added constraint.",
  "For the AI-enabled round, practise extending a small codebase and check every AI suggestion.",
  "Listen for interviewer hints; sources say they matter.",
  "Prepare stories about conflict, mistakes and disagreeing with a coworker.",
  "In design rounds, ask whether estimates are wanted before spending time on them."
